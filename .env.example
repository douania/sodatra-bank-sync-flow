# Supabase — clé API publishable moderne côté frontend (sb_publishable_*, jamais sb_secret_*)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# .env est VERSIONNE et porte la cible de PRODUCTION : c'est le seul canal
# supporte par Lovable pour transmettre les VITE_* au build. Il ne contient que
# ces trois memes valeurs publiques (voir docs/SECURITY_CONTRACT.md section 6).
# Pour surcharger localement (ex. staging), creer .env.local, qui reste ignore
# par git et prime sur .env. Aucune cle backend nulle part.
