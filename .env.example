# Supabase — clé API publishable moderne côté frontend (sb_publishable_*, jamais sb_secret_*)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Module chèques — drapeau public de production, seul ajout autorisé (liste fermée)
VITE_PAYABLES_CHEQUES_PRODUCTION_ADMIN_ONLY=

# .env est VERSIONNE et porte la cible de PRODUCTION : c'est le seul canal
# supporte par Lovable pour transmettre les VITE_* au build. Il ne contient que
# ces trois memes valeurs publiques et le seul drapeau
# VITE_PAYABLES_CHEQUES_PRODUCTION_ADMIN_ONLY=true (voir docs/SECURITY_CONTRACT.md
# section 6). Pour surcharger localement (ex. staging), creer .env.local, qui
# reste ignore par git et prime sur .env. Aucune cle backend nulle part.
#
# Ce drapeau est herite de .env par toute build locale :
# - build qui vise la PRODUCTION (pas de .env.local, ou cible production
#   conservee) : elle ouvre le meme mode administration seule de production que
#   la build publiee, sous la meme autorisation serveur ;
# - build qui vise une AUTRE cible (locale, staging) : .env.local doit
#   NEUTRALISER le drapeau, sinon le module cheques y est refuse
#   (« Le mode administration seule est reserve au projet de production ») :
#   VITE_PAYABLES_CHEQUES_PRODUCTION_ADMIN_ONLY=
# Seule la valeur exacte « true » active le mode ; une valeur vide le desactive.
