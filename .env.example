# Supabase — clés publiques côté frontend (clé anon publishable, jamais service_role)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Developpement local : copier ce fichier en .env (ignore par git) et y mettre
# la cible autorisee. Le build de PRODUCTION lit .env.production, versionne,
# qui ne contient que ces trois memes valeurs publiques (voir
# docs/SECURITY_CONTRACT.md section 6). Aucune cle backend nulle part.
